<mujoco model="diy_arena_map_world7_mpcc_benchmark_arena">
    <!-- ============================================================================= -->
    <!-- WORLD7.XML: BẢN ĐỒ ĐỐI CHỨNG 2 BIẾN THỂ DFE-MPCC (CÓ VS KHÔNG CHECKPOINT)     -->
    <!-- "Resonant S-Chicane & Checkpoint Apex-Braking Benchmark Arena (mu = 0.35)"     -->
    <!-- Thiết kế để đối chứng công bằng giữa:                                         -->
    <!--   (1) DFE-MPCC Không Checkpoint : ROM cơ sở, chưa chuẩn hóa WCSPH/Conformal   -->
    <!--   (2) DFE-MPCC Có Checkpoint    : Tích hợp Ống vận tốc KM + Checkpoint WCSPH  -->
    <!-- Tạm thời cố định mặt sàn phẳng, ma sát đồng nhất mu = 0.35 toàn tuyến.        -->
    <!-- ============================================================================= -->
    <compiler angle="radian"/>
    <option gravity="0 0 -9.81" timestep="0.005"/>

    <asset>
        <texture name="grid" type="2d" builtin="checker" rgb1=".18 .26 .36" rgb2=".10 .16 .24" width="300" height="300"/>
        <material name="gridmat" texture="grid" texrepeat="20 20" reflectance="0.2"/>
    </asset>

    <default>
        <default class="wall">
            <geom type="box" group="1" rgba="0.52 0.56 0.64 1" friction="0.8 0.005 0.0001"/>
        </default>
        <default class="obs">
            <geom group="1" friction="0.8 0.005 0.0001"/>
        </default>
        <default class="dyn_obs">
            <geom group="1" friction="0.8 0.005 0.0001"/>
        </default>
        <default class="marker">
            <site type="cylinder" size="0.25 0.005" group="2"/>
        </default>
    </default>

    <worldbody>
        <light pos="0 0 4" dir="0 0 -1" diffuse="1 1 1"/>

        <!-- Sàn đấu trường 8x8 m -->
        <geom name="ground" type="plane" size="4 4 0.1" material="gridmat"/>

        <!-- ĐIỂM XUẤT PHÁT VÀ ĐÍCH ĐẾN (START / GOAL MARKERS) -->
        <geom name="start_marker" group="2" type="cylinder" size="0.22 0.004" pos="-2.25 -2.25 0.004" rgba="0.2 0.4 1 0.7" contype="0" conaffinity="0"/>
        <geom name="goal_marker"  group="2" type="cylinder" size="0.22 0.004" pos="2.25 2.25 0.004"   rgba="0.1 0.9 0.2 0.7" contype="0" conaffinity="0"/>

        <!-- Sàn phẳng đồng nhất mu = 0.35 (đã tạm ẩn các thảm bẫy ma sát để tách bạch kiểm chứng Checkpoint) -->

        <!-- ================================================================= -->
        <!-- 1. TƯỜNG BAO NGOÀI ĐẤU TRƯỜNG (OUTER BOUNDARY WALLS - 6x6 M)     -->
        <!-- ================================================================= -->
        <geom class="wall" name="wall_n" size="3.05 0.05 0.5" pos="0 3.0 0.5"/>
        <geom class="wall" name="wall_s" size="3.05 0.05 0.5" pos="0 -3.0 0.5"/>
        <geom class="wall" name="wall_e" size="0.05 3.05 0.5" pos="3.0 0 0.5"/>
        <geom class="wall" name="wall_w" size="0.05 3.05 0.5" pos="-3.0 0 0.5"/>

        <!-- ================================================================= -->
        <!-- 2. HỆ THỐNG VÁCH NGĂN TẠO CỤM CHICANE CỘNG HƯỞNG & 4 VÙNG VẬT LÝ -->
        <!-- ================================================================= -->
        <!-- Vách tường 1 (Dọc Tây - nối tường Nam từ y=-3.0 lên y=+1.35): mở cửa thông phía Bắc -->
        <geom class="wall" name="wall_1" size="0.04 2.175 0.5" pos="-1.45 -0.825 0.5"/>

        <!-- Vách tường 1b (Chicane cộng hưởng Tây - nhô từ tường Tây ở y=-0.35 vào x=-2.42) -->
        <geom class="wall" name="wall_1_fin" size="0.29 0.04 0.5" pos="-2.71 -0.35 0.5"/>

        <!-- Vách tường 2 (Dọc Trung tâm - nối tường Bắc từ y=+3.0 xuống y=-1.35) -->
        <geom class="wall" name="wall_2" size="0.04 2.175 0.5" pos="-0.05 0.825 0.5"/>

        <!-- Vách tường 3 (Dọc Đông-Nam - nối tường Nam từ y=-3.0 lên y=+0.35) -->
        <geom class="wall" name="wall_3" size="0.04 1.675 0.5" pos="1.25 -1.325 0.5"/>

        <!-- Vách tường 4 (Ngang Bắc-Đông - nối kín từ wall_2 tại x=-0.05 sang x=+1.60 ở y=+1.72) -->
        <geom class="wall" name="wall_4" size="0.825 0.04 0.5" pos="0.775 1.72 0.5"/>
    </worldbody>
</mujoco>
